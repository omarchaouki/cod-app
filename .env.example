# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. NEVER prefix with NEXT_PUBLIC_ and never import it into a
# client component — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram)
# ---------------------------------------------------------------------------
# Browser pixel. Leave empty to disable the pixel entirely — no script is
# injected and no third-party JavaScript is loaded.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token — server side only.
META_ACCESS_TOKEN=
# Optional: shows events in Events Manager > Test Events while developing.
META_TEST_EVENT_CODE=

# ---------------------------------------------------------------------------
# TikTok
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Google Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Random string used to hash visitor IPs before storing them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me
